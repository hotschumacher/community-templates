<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>7.4</version>
    <template_groups>
        <template_group>
            <uuid>0ee0035dcab44107882b8de91eb2e044</uuid>
            <name>Templates/Network devices</name>
