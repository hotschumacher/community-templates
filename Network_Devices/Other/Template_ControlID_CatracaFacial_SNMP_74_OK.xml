    <templates>
        <template>
            <uuid>7b9fe9669eab44f686d47736d41a4af1</uuid>
            <template>Template ControlID Catraca Facial SNMP</template>
            <name>Template ControlID Catraca Facial SNMP</name>
            <description>Template SNMP para Control iD (Catraca Facial Estacionamento)
Itens baseados na MIB CONTROLID-MIB.
Monitoramento: CPU, Temperatura, Rede, Aplicação e Alarmes físicos.</description>
            <groups>
                <group>
                    <name>Templates/Network devices</name>
                </group>
            </groups>
            <items>
                <item>
                    <uuid>85561631b72c4503a4c98a59c2601f8f</uuid>
                    <name>CPU Usage (%)</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.49617.1.1.5.0</snmp_oid>
                    <key>system.cpu.usage</key>
                    <history>7d</history>
                    <value_type>FLOAT</value_type>
                    <units>%</units>
                    <description>Uso da CPU do dispositivo Control iD via SNMP</description>
                    <triggers>
                        <trigger>
                            <uuid>32523e4359494618bed3191dbe2d5588</uuid>
                            <expression>last(/Template ControlID Catraca Facial SNMP/system.cpu.usage)&gt;=85</expression>
                            <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                            <recovery_expression>last(/Template ControlID Catraca Facial SNMP/system.cpu.usage)&lt;=60</recovery_expression>
                            <name>CPU alta em {HOST.NAME}</name>
                            <description>Alerta quando o uso de CPU da catraca excede 85%</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <uuid>39127798ee4849c4b1e93f241e2692b6</uuid>
                    <name>CPU Temperature (°C)</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.49617.1.1.6.0</snmp_oid>
                    <key>system.cpu.temp</key>
                    <history>7d</history>
                    <value_type>FLOAT</value_type>
                    <units>°C</units>
                    <description>Temperatura da CPU (valor original em milésimos de grau)</description>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <parameters>
                                <parameter>0.001</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <triggers>
                        <trigger>
                            <uuid>2846e3f980f045849638da32038c59b5</uuid>
                            <expression>last(/Template ControlID Catraca Facial SNMP/system.cpu.temp)&gt;=70</expression>
                            <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                            <recovery_expression>last(/Template ControlID Catraca Facial SNMP/system.cpu.temp)&lt;=60</recovery_expression>
                            <name>Temperatura alta da CPU em {HOST.NAME}</name>
                            <description>Temperatura da CPU acima de 70°C</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <uuid>cde46de1ea3043c59f5106956539f058</uuid>
